%% Diagramme de cas d'utilisation (approximation flowchart) — Gestion des Stages OCP
%% Rendu : https://mermaid.live  →  exporter en PNG/SVG pour le rapport
flowchart LR
    visiteur([Visiteur]):::actor
    stagiaire([Stagiaire]):::actor
    encadrant([Encadrant]):::actor
    rh([Admin / Responsable RH]):::actor

    uc1((Postuler à une offre))
    uc2((Consulter les offres))
    uc3((Déposer ses documents))
    uc4((Remplir la fiche OCP))
    uc5((Déposer le rapport))
    uc6((Sélectionner un candidat))
    uc7((Planifier un entretien))
    uc8((Suivre / Évaluer))
    uc9((Valider le rapport))
    uc10((Valider dossier / convention))
    uc11((Gérer les comptes))
    uc12((Tableaux de bord & exports))
    uc13((Assistant IA))
    uc14((Archiver le stage))

    visiteur --- uc1 & uc2
    stagiaire --- uc3 & uc4 & uc5
    encadrant --- uc6 & uc7 & uc8 & uc9
    rh --- uc10 & uc11 & uc12 & uc13 & uc14

    classDef actor fill:#00843D,color:#fff,stroke:#003B1C,stroke-width:1px;
